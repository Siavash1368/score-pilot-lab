# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
# Relative paths resolve against the repository root. Defaults: data/raw and data/lc.duckdb.
# Point both outside a synced folder (OneDrive, Dropbox) to keep multi-GB files local, e.g.
#   RAW_DATA_DIR=D:/score-pilot-lab-data/raw
#   DUCKDB_PATH=D:/score-pilot-lab-data/lc.duckdb
RAW_DATA_DIR=data/raw
DUCKDB_PATH=data/lc.duckdb
